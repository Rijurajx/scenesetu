# SceneSetu Backend Environment Configuration

# Application
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# Database (Supabase PostgreSQL / Async engine)
# e.g., postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# For local dev fallback without postgres, sqlite+aiosqlite:///./scenesetu.db can also be used
DATABASE_URL=sqlite+aiosqlite:///./scenesetu.db

# Supabase Storage & Service API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=scenesetu-assets

# AI Providers
# Google Gemini API key (Free tier from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Pixazo API (Hosted Image / Video generation)
PIXAZO_API_KEY=your-pixazo-api-key
PIXAZO_BASE_URL=https://api.pixazo.ai/v1
PIXAZO_IMAGE_MODEL=flux-schnell
